#!/bin/bash

# Matrix digital rain screensaver for Omarchy.
#
# Drop-in replacement for Omarchy's omarchy-launch-screensaver. Installed as a symlink in
# ~/.local/bin, which ~/.bashrc puts ahead of $OMARCHY_PATH/bin, so the Omarchy shell's
# idle service (shell.json -> idle.screensaver) and the Omarchy menu launch this instead
# of the stock terminal screensaver. Runs matrix-rain-tty in your default terminal, one
# fullscreen window per monitor, the same way Omarchy runs its own. Falls back to the
# stock screensaver if matrix-rain-tty has not been built.
#
# Usage: omarchy-launch-screensaver [force]      (force ignores the screensaver-off toggle)
#        omarchy-launch-screensaver stop
#
# Environment:
#   MATRIX_TTY_FONT_SIZE     terminal font size (default 9)
#   MATRIX_TTY_LINE_HEIGHT   row height, e.g. 14px (default 14px; foot and kitty take it as the
#                            row height, Alacritty and Ghostty as an adjustment, only when set)
#   MATRIX_TTY_THEME         1 (default) colours the rain from the current Omarchy theme; 0 keeps green
#   MATRIX_TTY_ARGS          extra options for matrix-rain-tty, e.g. "--trail 12 --speed-k 0.8"

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
MATRIX_DIR="${MATRIX_DIR:-$(dirname "$SELF")}"
TTY="$MATRIX_DIR/matrix-rain-tty"
CLASS="org.omarchy.screensaver"
STOCK="${OMARCHY_PATH:-/usr/share/omarchy}/bin/omarchy-launch-screensaver"

set_cursor_hidden() {
  hyprctl eval "hl.config({ cursor = { invisible = $1 } })" >/dev/null 2>&1 || hyprctl keyword cursor:invisible "$1" >/dev/null 2>&1
}

stop_screensaver() {
  pkill -f "[o]rg.omarchy.screensaver" 2>/dev/null
  set_cursor_hidden false
}

if [[ $1 == stop ]]; then
  stop_screensaver
  exit 0
fi

# Exit early if a screensaver is already running
pgrep -f "[o]rg.omarchy.screensaver" >/dev/null && exit 0

# Allow screensaver to be turned off but also force started
if omarchy-toggle-enabled screensaver-off && [[ $1 != "force" ]]; then
  exit 1
fi

# Not built? Use Omarchy's own screensaver instead.
if [[ ! -x $TTY ]]; then
  echo "matrix-rain-tty is not built (run make in $MATRIX_DIR); using Omarchy's screensaver" >&2
  exec "$STOCK" "$@"
fi

terminal=$(xdg-terminal-exec --print-id 2>/dev/null)
case $terminal in
*Alacritty* | *ghostty* | *foot* | *kitty*) ;;
*)
  omarchy-notification-send -g ✋ "Screensaver only runs in Alacritty, Foot, Ghostty, or Kitty"
  exit 1
  ;;
esac

focused=$(omarchy-hyprland-monitor-focused)

hypr_focus_monitor() {
  hyprctl dispatch "hl.dsp.focus({ monitor = \"$1\" })" >/dev/null 2>&1 || hyprctl dispatch focusmonitor "$1" >/dev/null
}

hypr_exec() {
  local command
  printf -v command '%q ' "$@"
  hyprctl dispatch "hl.dsp.exec_cmd([[$command]])" >/dev/null 2>&1 || hyprctl dispatch exec -- bash -lc "$command" >/dev/null
}

SOCKET="$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock"

# Open Hyprland's event stream before spawning anything, so a window that maps
# quickly can't emit its openwindow event before we are listening for it.
exec {events}< <(socat -U - "UNIX-CONNECT:$SOCKET")
socat_pid=$!

# Block until this monitor's screensaver window actually opens before moving focus on.
# Records the window address so the watchdog below can recognise our windows.
windows=()
wait_for_screensaver_window() {
  local line deadline=$((SECONDS + 5))
  while ((SECONDS < deadline)) && IFS= read -r -t $((deadline - SECONDS)) -u "$events" line; do
    if [[ $line == openwindow\>\>*,$CLASS,* ]]; then
      line=${line#openwindow>>}
      windows+=("${line%%,*}")
      return 0
    fi
  done
}

# Terminal font: the system monospace font Omarchy is set to, at 9 pt rather than the 18 pt
# of Omarchy's screensaver configs, with rows tighter than a Nerd Font's ~18 px line metrics.
font=$(omarchy-font-current 2>/dev/null); font="${font:-JetBrainsMono Nerd Font}"
size="${MATRIX_TTY_FONT_SIZE:-9}"
lh="${MATRIX_TTY_LINE_HEIGHT:-14px}"
adj="${MATRIX_TTY_LINE_HEIGHT:-}"

# Colour the rain from the current Omarchy theme: the stream takes the accent, the head
# the bright foreground. Anything in MATRIX_TTY_ARGS comes later on the command line,
# so it still overrides.
theme_args=()
if [[ ${MATRIX_TTY_THEME:-1} != 0 ]]; then
  accent=$(omarchy-theme-color accent 2>/dev/null); head=$(omarchy-theme-color bright_foreground 2>/dev/null)
  [[ $accent =~ ^#?[0-9A-Fa-f]{6}$ ]] && theme_args+=(--stream "${accent#\#}")
  [[ $head =~ ^#?[0-9A-Fa-f]{6}$ ]] && theme_args+=(--head "${head#\#}")
fi
# shellcheck disable=SC2206
args=(--screensaver "${theme_args[@]}" $MATRIX_TTY_ARGS)

set_cursor_hidden true
for m in $(hyprctl monitors -j | jq -r '.[] | .name'); do
  hypr_focus_monitor "$m"
  case $terminal in
    *Alacritty*) hypr_exec alacritty --class="$CLASS" --config-file "$OMARCHY_PATH/default/alacritty/screensaver.toml" -o "font.size=$size" ${adj:+-o "font.offset.y=${adj%px}"} -e "$TTY" "${args[@]}" ;;
    *ghostty*)   hypr_exec ghostty --class="$CLASS" --config-file="$OMARCHY_PATH/default/ghostty/screensaver" --font-size="$size" ${adj:+--adjust-cell-height="${adj%px}"} -e "$TTY" "${args[@]}" ;;
    *foot*)      hypr_exec foot --app-id="$CLASS" --config="$OMARCHY_PATH/default/foot/screensaver.ini" -o "main.font=$font:size=$size" ${lh:+-o "main.line-height=$lh"} -e "$TTY" "${args[@]}" ;;
    *kitty*)     hypr_exec kitty --class="$CLASS" --override "font_size=$size" --override window_padding_width=0 ${lh:+--override "modify_font=cell_height ${lh%px}px"} -e "$TTY" "${args[@]}" ;;
  esac
  wait_for_screensaver_window
done

hypr_focus_monitor "$focused"

# Watchdog: keeps reading Hyprland events in the background and tears the screensaver
# down when focus moves to a window that is not a screensaver (the user did something)
# or every screensaver window has closed (a key press made matrix-rain-tty exit).
(
  is_ours() { local a; for a in "${windows[@]}"; do [[ $a == "$1" ]] && return 0; done; return 1; }
  remaining=${#windows[@]}
  while IFS= read -r -u "$events" line; do
    case $line in
      activewindowv2\>\>*)
        addr=${line#activewindowv2>>}
        if [[ -n $addr && $addr != "," ]] && ! is_ours "$addr" && pgrep -f "[o]rg.omarchy.screensaver" >/dev/null; then
          stop_screensaver; break
        fi
        ;;
      closewindow\>\>*)
        addr=${line#closewindow>>}
        if is_ours "$addr" && (( --remaining <= 0 )); then stop_screensaver; break; fi
        ;;
    esac
  done
  exec {events}<&-
  [[ -n $socat_pid ]] && kill "$socat_pid" 2>/dev/null
) >/dev/null 2>&1 &
disown
exec {events}<&-
